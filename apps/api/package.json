{
  "name": "@spendwise/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@spendwise/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@spendwise/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "~18.0.9",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
