# Copy this file to .env and adjust if needed: cp .env.example .env
NODE_ENV=development
PORT=4000

# Matches infra/docker/docker-compose.yml (start it with `pnpm db:up`)
DATABASE_URL=postgresql://expenseflow:expenseflow@localhost:5432/expenseflow

# Comma-separated list of web origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
